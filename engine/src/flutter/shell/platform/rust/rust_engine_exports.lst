# Linker script for the application-facing Rust engine library. Keep this
# boundary limited to the private shell ABI and the VM snapshot symbols that
# Dart discovers in the loaded library.

{
  global:
    FlutterRustShell*;
    kDartSnapshotData;
    kDartSnapshotText;
  local:
    *;
};
