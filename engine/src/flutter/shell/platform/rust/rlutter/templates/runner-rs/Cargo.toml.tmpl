[package]
name = "{{projectName}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.93"
publish = false
build = "build.rs"

[lib]
path = "src/lib.rs"

[[bin]]
name = "{{projectName}}"
path = "src/main.rs"

[dependencies]
flutter-plugin-sdk = { path = "../.dart_tool/flutter_rs/sdk/crates/flutter-plugin-sdk" }

# === BEGIN FLUTTER GENERATED RUST PLUGINS ===
# === END FLUTTER GENERATED RUST PLUGINS ===

[target.'cfg(target_os = "linux")'.dependencies]
flutter-shell-winit = { path = "../.dart_tool/flutter_rs/sdk/crates/flutter-shell-winit" }

[patch.crates-io]
flutter-plugin-sdk = { path = "../.dart_tool/flutter_rs/sdk/crates/flutter-plugin-sdk" }
winit-wayland = { path = "../.dart_tool/flutter_rs/sdk/third_party/winit-wayland" }
android-activity = { git = "https://github.com/nrbnlulu/android-activity", rev = "10cf552eba323e5c9cd26f6e2619d62050f2395c" }

[profile.flutter-profile]
inherits = "release"
debug = true

[workspace]

[lints.rust]
unexpected_cfgs = { level = "warn", check-cfg = ["cfg(frb_expand)"] }
